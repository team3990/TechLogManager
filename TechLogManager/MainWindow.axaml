<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="TechLogManager.MainWindow"
        Title="Tech Log Manager"
        Icon="/Assets/icon.ico"
        x:DataType="Window"
        x:CompileBindings="True"
        WindowState="Maximized">

    <Grid Margin="10" RowDefinitions="Auto,20,Auto,20,Auto,20,Auto,20,Auto,*,Auto">
        <!-- Settings Button -->
        <Button Name="SettingsButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Grid.Row="0"
                Click="SettingsButton_Click"
                Background="Transparent"
                BorderThickness="1"
                BorderBrush="Gray"
                Padding="10"
                ToolTip.Tip="Settings"
                Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="⚙️" FontSize="16" />
                <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Team Selection -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Enter Your Team Number" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" />
            <TextBox Name="TeamNumberTextBox"
                     Width="200"
                     Height="40"
                     Margin="0,10,0,0"
                     FontSize="16"
                     HorizontalAlignment="Left"
                     TextAlignment="Center"
                     TextChanged="TeamNumberTextBox_TextChanged" />
        </StackPanel>

        <!-- Path Selection -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Folder name" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" />
            <TextBox Name="DestinationFolderTextBox"
                     Width="200"
                     Height="40"
                     Margin="0,10,0,0"
                     FontSize="16"
                     HorizontalAlignment="Left"
                     TextAlignment="Center"
                     TextChanged="DestinationFolderTextBox_TextChanged" />
        </StackPanel>

        <!-- Action Selection -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Choose Operation" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" />
            <StackPanel HorizontalAlignment="Left" Margin="0,10,0,0">
                <RadioButton Name="DlAndDelRadio" Content="Download and Delete" GroupName="Action" IsChecked="True"
                             Margin="10,0" />
                <RadioButton Name="DownloadRadio" Content="Download Only" GroupName="Action" Margin="10,0" />
                <RadioButton Name="DeleteRadio" Content="Delete Only" GroupName="Action" Margin="10,0" />
            </StackPanel>
        </StackPanel>

        <!-- What to Download -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="What to Download" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" />
            <StackPanel HorizontalAlignment="Left" Margin="0,10,0,0">
                <CheckBox Name="RoborioCheckbox" Content="RoboRIO Logs" IsChecked="True" />
                <CheckBox Name="LimelightCheckbox" Content="Limelight Recordings" IsChecked="True" />
                <CheckBox Name="DsLogsCheckbox" Content="Driver station logs" IsChecked="False" />
                <CheckBox Name="HootCheckbox" Content="CTRE (hoot) logs" IsChecked="False" />
            </StackPanel>
        </StackPanel>

        <!-- How many -->
        <StackPanel Grid.Row="8">
            <TextBlock Text="How many ?" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                <RadioButton Name="AllRadio" Content="All" GroupName="Many" IsChecked="True" Margin="10,0" />
                <RadioButton Name="LatestRadio" Content="Latest one" GroupName="Many" Margin="10,0" />
            </StackPanel>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Name="StartButton" Content="Start" Width="120" Height="40" Click="StartButton_Click" />
            <Button Name="CommitButton" Content="Commit" Width="120" Height="40" Click="CommitButton_Click"
                    Margin="5" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>