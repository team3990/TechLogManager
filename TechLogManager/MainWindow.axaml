<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" x:Class="TechLogManager.MainWindow" Title="Tech Log Manager" WindowState="Maximized">

    <Grid Margin="20" RowDefinitions="Auto,20,Auto,20,Auto,20,Auto,20,Auto,20,*,20,Auto">
        <!-- Team Selection -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Enter Your Team Number" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBox Name="TeamNumberTextBox"
                     Width="200"
                     Height="40"
                     Margin="0,10,0,0"
                     FontSize="16"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextChanged="TeamNumberTextBox_TextChanged" />
            <TextBlock Name="SelectedTeamText"
                       Text="No team entered"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
        </StackPanel>

        <!-- Path Selection -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Folder name" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBox Name="DestinationFolderTextBox"
                     Width="200"
                     Height="40"
                     Margin="0,10,0,0"
                     FontSize="16"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextChanged="DestinationFolderTextBox_TextChanged" />
            <TextBlock Name="DestinationFolderText"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
        </StackPanel>

        <!-- Action Selection -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Choose Operation" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <RadioButton Name="DlAndDelRadio" Content="Download and Delete" GroupName="Action" IsChecked="True"
                             Margin="10,0" />
                <RadioButton Name="DownloadRadio" Content="Download Only" GroupName="Action" Margin="10,0" />
                <RadioButton Name="DeleteRadio" Content="Delete Only" GroupName="Action" Margin="10,0" />
            </StackPanel>
        </StackPanel>

        <!-- What to Download -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="What to Download" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
            <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                <CheckBox Name="RoborioCheckbox" Content="RoboRIO Logs" IsChecked="True" />
                <CheckBox Name="LimelightCheckbox" Content="Limelight Recordings" IsChecked="True" />
                <CheckBox Name="DsLogsCheckbox" Content="Driver station logs" IsChecked="False" />
                <CheckBox Name="HootCheckbox" Content="CTRE (hoot) logs" IsChecked="False" />
            </StackPanel>
        </StackPanel>

        <!-- How many -->
        <StackPanel Grid.Row="8">
            <TextBlock Text="How many ?" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <RadioButton Name="AllRadio" Content="All" GroupName="Many" IsChecked="True" Margin="10,0" />
                <RadioButton Name="LatestRadio" Content="Latest one" GroupName="Many" Margin="10,0" />
            </StackPanel>
        </StackPanel>

        <!-- Log Output -->
        <Border Grid.Row="10" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <ScrollViewer>
                <TextBlock Name="LogOutput" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
            </ScrollViewer>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="StartButton" Content="Start" Width="120" Height="40" Click="StartButton_Click" Margin="5" />
            <Button Name="CommitButton" Content="Commit" Width="120" Height="40" Click="CommitButton_Click"
                    Margin="5" IsEnabled="False" />
            <Button Name="PushButton" Content="Push" Width="120" Height="40" Click="PushButton_Click" Margin="5"
                    IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>