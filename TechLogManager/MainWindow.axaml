<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
        x:Class="TechLogManager.MainWindow"
        Title="Tech Log Manager"
        Width="500" Height="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20" RowDefinitions="Auto,20,Auto,20,Auto,20,*,20,Auto">
        <!-- Team Selection -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Select Your Team" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Name="Team9406Button" Width="150" Height="150" Margin="10" Click="Team9406Button_Click">
                    <Button.Content>
                        <StackPanel>
                            <TextBlock Text="Team 9406" FontSize="16" FontWeight="Bold" />
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Name="Team3990Button" Width="150" Height="150" Margin="10" Click="Team3990Button_Click">
                    <Button.Content>
                        <StackPanel>
                            <TextBlock Text="Team 3990" FontSize="16" FontWeight="Bold" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
            <TextBlock Name="SelectedTeamText" Text="No team selected" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>

        <!-- Action Selection -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Choose Operation" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <RadioButton Name="DlAndDelRadio" Content="Download and Delete" GroupName="Action" IsChecked="True"
                             Margin="10,0" />
                <RadioButton Name="DownloadRadio" Content="Download Only" GroupName="Action" Margin="10,0" />
                <RadioButton Name="DeleteRadio" Content="Delete Only" GroupName="Action" Margin="10,0" />
            </StackPanel>
        </StackPanel>

        <!-- What to Download -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="What to Download" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
            <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                <CheckBox Name="RoborioCheckbox" Content="RoboRIO Logs" IsChecked="True" />
                <CheckBox Name="LimelightCheckbox" Content="Limelight Recordings" IsChecked="True" Margin="0,5,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Log Output -->
        <Border Grid.Row="6" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <ScrollViewer>
                <TextBlock Name="LogOutput" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
            </ScrollViewer>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="StartButton" Content="Start" Width="120" Height="40" Click="StartButton_Click" Margin="5" />
            <Button Name="CommitButton" Content="Git Commit" Width="120" Height="40" Click="CommitButton_Click"
                    Margin="5" IsEnabled="False" />
            <Button Name="PushButton" Content="Git Push" Width="120" Height="40" Click="PushButton_Click" Margin="5"
                    IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>