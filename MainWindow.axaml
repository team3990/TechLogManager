<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TechLogManager"
        mc:Ignorable="d"
        x:Class="TechLogManager.MainWindow"
        Title="Tech Log Manager"
        Icon="/Assets/icon.ico"
        x:DataType="Window"
        x:CompileBindings="True"
        WindowState="Maximized">

    <Grid Margin="10" ColumnDefinitions="Auto,20,*">
        <!-- Left Panel: Settings and Controls -->
        <Grid Grid.Column="0" RowDefinitions="Auto,20,Auto,20,Auto,20,Auto,20,Auto,*,Auto">
            <!-- Team Selection -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Enter Your Team Number" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Left" />
                <TextBox Name="TeamNumberTextBox"
                         Width="200"
                         Height="40"
                         Margin="0,10,0,0"
                         FontSize="16"
                         HorizontalAlignment="Left"
                         TextAlignment="Center"
                         TextChanged="TeamNumberTextBox_TextChanged" />
            </StackPanel>

            <!-- Path Selection -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Folder name" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" />
                <TextBox Name="DestinationFolderTextBox"
                         Width="200"
                         Height="40"
                         Margin="0,10,0,0"
                         FontSize="16"
                         HorizontalAlignment="Left"
                         TextAlignment="Center"
                         TextChanged="DestinationFolderTextBox_TextChanged" />
            </StackPanel>

            <!-- What to Download -->
            <StackPanel Grid.Row="4">
                <TextBlock Text="What to Download" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" />
                <StackPanel HorizontalAlignment="Left" Margin="0,10,0,0">
                    <CheckBox Name="RoborioCheckbox" Content="RoboRIO Logs" IsChecked="True" />
                    <CheckBox Name="LimelightCheckbox" Content="Limelight Recordings" IsChecked="True" />
                    <CheckBox Name="DsLogsCheckbox" Content="Driver station logs" IsChecked="False" />
                    <CheckBox Name="HootCheckbox" Content="CTRE (hoot) logs" IsChecked="False" />
                </StackPanel>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Name="StartButton" Content="Discover Logs" Width="140" Height="40" Click="StartButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Right Panel: Log List View -->
        <Grid Grid.Column="2" RowDefinitions="Auto,10,Auto,10,*">
            <!-- Settings Button -->
            <Button Name="SettingsButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Grid.Row="0"
                    Click="SettingsButton_Click"
                    Background="Transparent"
                    BorderThickness="1"
                    BorderBrush="Gray"
                    Padding="10"
                    ToolTip.Tip="Settings"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="⚙️" FontSize="16" />
                    <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Row="0" Text="Discovered Logs" FontSize="20" FontWeight="Bold" />

            <!-- Bulk Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                <Button Name="SelectAllButton" Content="Select All" Click="SelectAllButton_Click" />
                <Button Name="DeselectAllButton" Content="Deselect All" Click="DeselectAllButton_Click" />
                <Button Name="DownloadSelectedButton" Content="Download Selected" Click="DownloadSelectedButton_Click" />
                <Button Name="DeleteSelectedButton" Content="Delete Selected" Click="DeleteSelectedButton_Click" />
                <Button Name="DownloadAllButton" Content="Download All" Click="DownloadAllButton_Click" />
                <Button Name="DeleteAllButton" Content="Delete All" Click="DeleteAllButton_Click" />
                <DropDownButton Name="FilterButton" Content="Filter">
                    <DropDownButton.Flyout>
                        <MenuFlyout Closed="FilterFlyout_Closed">
                            <CheckBox Name="RoborioFilterCheckbox" Content="RoboRIO Logs" IsChecked="True" />
                            <CheckBox Name="LimelightFilterCheckbox" Content="Limelight Recordings" IsChecked="True" />
                            <CheckBox Name="DsLogsFilterCheckbox" Content="Driver station logs" IsChecked="True" />
                            <CheckBox Name="HootFilterCheckbox" Content="CTRE (hoot) logs" IsChecked="True" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <!-- Log List -->
            <ListBox Grid.Row="4" Name="LogListBox" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="local:LogEntryViewModel">
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="7.2, 6.8, 7.2, 6.8" Margin="-5"
                                CornerRadius="5" IsVisible="{Binding IsVisible}">
                            <Grid ColumnDefinitions="Auto,10,*,10,Auto,10,Auto">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                    <TextBlock Text="{Binding Source}" FontSize="12" Foreground="Gray" />
                                </StackPanel>

                                <Button Grid.Column="4" Content="Download" Click="DownloadButton_Click"
                                        IsEnabled="{Binding !IsDownloading}" Width="100" />
                                <Button Grid.Column="6" Content="Delete" Click="DeleteButton_Click" Foreground="Red"
                                        IsEnabled="{Binding !IsDeleting}" Width="100" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
